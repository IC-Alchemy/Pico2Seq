<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Pico2Seq_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pico2Seq_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pico2Seq_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: transport + live status (caption/value pairs so screen
             readers announce label and value separately) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <ToggleButton
                x:Name="TransportButton"
                IsChecked="{x:Bind ViewModel.TransportRunning, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleTransportCommand, Mode=OneTime}"
                AutomationProperties.AutomationId="TransportButton"
                ToolTipService.ToolTip="Play / Stop (Space)">
                <ToggleButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Space" />
                </ToggleButton.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{x:Bind GlyphFor(ViewModel.TransportRunning), Mode=OneWay}" FontSize="16" />
                    <TextBlock Text="{x:Bind LabelFor(ViewModel.TransportRunning), Mode=OneWay}" />
                </StackPanel>
            </ToggleButton>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center"
                        AutomationProperties.Name="Tempo">
                <TextBlock Text="Tempo" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.TempoText, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center"
                        AutomationProperties.Name="Voice">
                <TextBlock Text="Voice" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.VoiceText, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center"
                        AutomationProperties.Name="Scale">
                <TextBlock Text="Scale" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ScaleText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center"
                        AutomationProperties.Name="Shuffle">
                <TextBlock Text="Shuffle" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ShuffleText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Instrument body: pad grid + OLED -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 4x8 pad grid, mirroring the touch matrix; cell glow = LED frame -->
            <ItemsRepeater x:Name="PadRepeater" Grid.Column="0"
                           Width="458" HorizontalAlignment="Left" VerticalAlignment="Top"
                           AutomationProperties.AutomationId="PadGrid"
                           ElementPrepared="OnPadElementPrepared"
                           ItemsSource="{x:Bind ViewModel.Pads, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="52" MinItemHeight="52"
                                       MinColumnSpacing="6" MinRowSpacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:PadCellViewModel">
                        <Button Padding="0" CornerRadius="6"
                                AutomationProperties.Name="{x:Bind Name}"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                PointerPressed="{x:Bind OnPointerPressed}"
                                PointerReleased="{x:Bind OnPointerReleased}"
                                PointerCanceled="{x:Bind OnPointerReleased}"
                                PointerCaptureLost="{x:Bind OnPointerReleased}">
                            <Grid>
                                <!-- Theme-aware idle base under the device-literal LED glow
                                     (Rectangle has no CornerRadius in WinUI; RadiusX/Y = 4px). -->
                                <Rectangle Margin="4" RadiusX="4" RadiusY="4"
                                           Fill="{ThemeResource P2SPadIdleBrush}" />
                                <Rectangle Margin="4" RadiusX="4" RadiusY="4"
                                           Fill="{x:Bind LedBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Number}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- OLED canvas: native 128x64 frame, scaled 2.5x -->
            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Background="#FF101014" Padding="8" VerticalAlignment="Top">
                <Image x:Name="OledImage" Width="320" Height="160"
                       AutomationProperties.Name="Device OLED screen" />
            </Border>
        </Grid>
    </Grid>
</Page>
