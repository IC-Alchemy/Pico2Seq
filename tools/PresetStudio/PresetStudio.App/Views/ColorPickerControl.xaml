<UserControl x:Class="PresetStudio.App.Views.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <!-- DataContext is the PresetEditor: Red / Green / Blue / ColorHex. -->
    <StackPanel Width="250">
        <TextBlock Text="LED colour" Style="{StaticResource HeadingText}" />
        <UniformGrid x:Name="Palette" Columns="8" Margin="0,8,0,8" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Text="R" Foreground="#C0392B" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsMoveToPointEnabled="True" Value="{Binding Red, Mode=TwoWay}" Margin="0,3" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Red, StringFormat=0}" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="G" Foreground="#1E8449" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsMoveToPointEnabled="True" Value="{Binding Green, Mode=TwoWay}" Margin="0,3" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green, StringFormat=0}" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="B" Foreground="#2E86C1" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsMoveToPointEnabled="True" Value="{Binding Blue, Mode=TwoWay}" Margin="0,3" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue, StringFormat=0}" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource SubtleText}" FontSize="11" Margin="0,8,0,0"
                   Text="The LEDs are very bright and punchy. Pale colours look white and very dark ones look off, so saturated colours work best." />
    </StackPanel>
</UserControl>
