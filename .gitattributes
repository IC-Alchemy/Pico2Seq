# Normalize all text files to LF in the repository; git auto-detects and
# leaves binary files (e.g. *.uf2, *.pyc) untouched.
* text=auto

# Source and docs are checked out with LF everywhere, so Windows checkouts
# never manufacture phantom whole-file diffs.
*.md    text eol=lf
*.html  text eol=lf
*.ino   text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf

# The Delta checkout hook is a POSIX shell script; CRLF would break its shebang
# and every command in it on the shells Delta runs it with.
.agents/prepare text eol=lf

# Baseline list read by scripts/check_host_tests.cmake; CRLF would corrupt the names.
tests/known_failures.txt text eol=lf
scripts/*.cmake text eol=lf
